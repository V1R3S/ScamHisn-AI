{
  "manifest_version": 3,
  "name": "ScamHisn AI — Link & Fraud Inspector",
  "short_name": "ScamHisn AI",
  "version": "2.0.0",
  "description": "Check links, job posts, map links and screenshots with ScamHisn AI, or switch on Check Everything to have every site checked before you use it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ScamHisn AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scamhisn-ai-v2.onrender.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
