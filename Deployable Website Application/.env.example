# =============================================================================
# ScamHisn AI (حصن الاحتيال) — Environment Configuration
# Copy this file to `.env` for local development. NEVER commit `.env` to Git.
# =============================================================================

# Required for AI-powered forensic analysis & Google Search/Maps grounding
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemini model identifier (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# AI fallback chain (all optional). Order tried on every scan:
#   1. GEMINI_API_KEY   + GEMINI_MODEL
#   2. GEMINI_API_KEY_2 + GEMINI_MODEL           (second account, own rate limit)
#   3. every key        + GEMINI_FALLBACK_MODEL  (limits are counted per model)
#   4. LOCAL_LLM_*      self-hosted model, e.g. Jais 2 on llama.cpp / Ollama
#   5. rules only, clearly labelled "incomplete check" (never shown as "safe")
# -----------------------------------------------------------------------------

# Second Gemini key (or a comma-separated list in GEMINI_API_KEYS)
GEMINI_API_KEY_2=
# GEMINI_API_KEYS=key_one,key_two

# Backup Gemini models, comma-separated, tried in order when the primary fails.
# Each model has its own allowance. Copy ids exactly as Google AI Studio lists them, e.g.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_FALLBACK_MODEL=

# Self-hosted OpenAI-compatible endpoint, including the /v1 prefix.
# Local llama.cpp:  http://127.0.0.1:8080/v1      Ollama:  http://127.0.0.1:11434/v1
# From Render, use the public HTTPS address of your tunnel instead.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=jais-2-8b-chat
# Shared secret the tunnel / server requires, so strangers cannot use your GPU
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=45000
# Prompt budget in characters, sized for an 8k-token context window
LOCAL_LLM_MAX_PROMPT_CHARS=9000

# Ceiling for one AI attempt before the chain moves to the next provider
AI_REQUEST_TIMEOUT_MS=25000

# hybrid = Gemini researches live sources, the self-hosted model judges
# gemini_first = Gemini judges, the self-hosted model is only a fallback
# auto (default) = hybrid when LOCAL_LLM_BASE_URL is set, otherwise gemini_first
AI_PIPELINE=auto

# How long a failed Gemini key+model is left alone. While every key is cooling down,
# Job, Map and Image checks are paused and switch back on by themselves.
GEMINI_COOLDOWN_MS=120000

# HTTP server port (default: 3001)
PORT=3001

# Comma-separated list of allowed CORS origins (leave empty or * for open dev;
# set explicit origins in production, e.g. https://scamhisn.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Allow browser extensions (chrome-extension://, moz-extension://) to call /api/v1/*
CORS_ALLOW_EXTENSIONS=true

# Run Playwright Chromium headless shell in headless mode (true in production)
PLAYWRIGHT_HEADLESS=true

# Per-scan timeouts and concurrency caps to keep CPU/RAM lightweight
SCAN_TIMEOUT_MS=25000
NAVIGATION_TIMEOUT_MS=15000
MAX_CONCURRENT_SCANS=3
MAX_REDIRECT_HOPS=8

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# --- Claude (optional, recommended) ----------------------------------------------------------
# 1. Backup: when every Gemini key and model has failed or is cooling down, Claude researches
#    the page and reads the screenshot, so the Job, Map and Screenshot checks do not pause.
# 2. Check Everything (the browser extension toggle) asks Claude first, with the self-hosted
#    model judging, for every site the user opens.
# Leave empty to run without Claude. Key from https://platform.claude.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_TIMEOUT_MS=40000
